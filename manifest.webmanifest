{
  "name": "Spelling Quest",
  "short_name": "Spelling",
  "description": "Spelling practice built around the list your child actually brought home this week.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#221252",
  "theme_color": "#221252",
  "orientation": "portrait",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "related_applications": [
    { "platform": "webapp", "url": "./manifest.webmanifest", "id": "https://spellingquest.github.io/" }
  ],
  "prefer_related_applications": false
}
